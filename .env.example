# Required
ELEVENLABS_API_KEY=

# Language of speech recognition, synthesis and the bridge's own phrases: en | ru (phrases.py)
# VOICE_LANG=en
# ElevenLabs voice and TTS model. The default voice depends on VOICE_LANG (en: George, ru: Maxim).
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Claude Code session: tmux session name and working directory used by ./run.sh and ./start-session.sh
# CLAUDE_TMUX_SESSION=voice
# CLAUDE_CWD=${HOME}/project
# Explicit tmux target (session:window.pane). Without it (and without run.sh) bot.py runs in echo mode.
# TMUX_TARGET==voice:0.0       # leading "=": exact session name, otherwise tmux matches windows by prefix

# Behavior
# VOICE_PREFIX="[voice] "     # tag of voice messages; the rules in ~/.claude/CLAUDE.md refer to it
# BARGE_IN_SECS=0.5          # speech beyond the VAD trigger needed to interrupt the bot
# VAD_STOP_SECS=0.5          # pause after which Smart Turn judges the end of a phrase
# TURN_MAX_PAUSE_SECS=1.5    # pause after which a phrase is closed regardless
# FILLER_SECS=1.5            # claude silent longer than this: the bot says "one sec", "let me check"; 0 = off
# HOLD_SECS=2.5              # wait this long for the rest of an unfinished phrase ("Hmm..."); 0 = off
# MERGE_SECS=5               # a phrase this soon after the one sent is merged with it
# BEEP=1                     # short tone when a phrase is sent to the session; 0 = off
# IMAGE_WAIT_SECS=10         # a photo without a caption waits this long for a phrase, then goes alone
# IMAGES_DIR=                # where photos are stored; default ~/.cache/terminalvox/images (kept 7 days)
# HOLD_SECS, TURN_MAX_PAUSE_SECS and MERGE_SECS set the "normal" pace. The client picks fast / normal / slow on connect.
# TOOL_GAP_SECS=4            # announce tool calls ("searching the web") at most this often; 0 = off
# MAX_SPOKEN_CHARS=600       # longer replies: the beginning is spoken, then "the rest is in the terminal"
# IDLE_TIMEOUT_SECS=600      # end the call after a long silence
# PORT=7860
# TAILNET_USERS=             # comma-separated Tailscale logins; default: the owner of this machine
# TAILSCALE_SERVE=1          # 0 = leave the tailscale serve config alone
# LOG_DIR=                   # rotating log file (the systemd service writes to ./logs)

# Only for tests/selftest.py: synthesizes test phrases (OpenAI TTS)
# OPENAI_API_KEY=
