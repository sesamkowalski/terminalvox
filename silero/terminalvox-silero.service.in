[Unit]
Description=TerminalVox: local Russian speech synthesis (Silero)

[Service]
Type=simple
WorkingDirectory=@DIR@/silero
Environment=PATH=%h/.local/bin:/snap/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@DIR@/silero/run.sh
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
