[Unit]
Description=TerminalVox: voice interface to Claude Code sessions (Pipecat)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@DIR@
# User systemd has no PATH from your shell profile: uv (snap), claude (~/.local/bin), tmux, tailscale.
Environment=PATH=%h/.local/bin:/snap/bin:/usr/local/bin:/usr/bin:/bin
Environment=LOG_DIR=@LOG_DIR@
ExecStart=@DIR@/run.sh
# Stop only the server: python is the main process (run.sh execs it). If run.sh started the tmux server
# itself, it and the claude sessions are in this unit too and must survive stop/restart.
KillMode=process
TimeoutStopSec=15
# Exit code 128+15 after SIGTERM is a normal stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
